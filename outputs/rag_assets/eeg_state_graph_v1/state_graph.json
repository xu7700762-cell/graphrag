  "sources": [
    {
      "id": "lee2025-alpha",
      "title": "Electroencephalography Changes During Cybersickness: Focusing on Delta and Alpha Waves",
      "year": 2025,
      "doi": "10.1007/s10548-025-01109-y",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11903544/",
      "locator": "Introduction, alpha paragraph; EEG Recording and Data Process; Results, alpha paragraph; Discussion, alpha/SSQ paragraphs",
      "excerpt": "Occipital alpha (8–13 Hz) decreased during a sickness-inducing video. Alpha direction differs across prior studies; this study found no significant alpha–SSQ association. These observations do not establish a universal severity rule.",
      "evidence_level": "medium",
      "review_status": "reviewed",
      "source_layer": "paper_evidence",
      "excerpt_type": "paraphrase",
