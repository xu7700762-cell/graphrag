    {
      "id": "local-vrms-protocol",
      "title": "Project raw EEG observation and frozen path-model protocol",
      "year": 2026,
      "doi": null,
      "url": "local://eeg_agent/tools.py",
      "locator": "eeg_agent/tools.py:BANDS, _spectral, _covariance; eeg_agent/online/features.py:BANDS; vrms knowledge cards, raw-only protocol and spectral/CSP sections",
      "excerpt": "Measured bands are theta 4–8 Hz, alpha 8–13 Hz, beta 13–30 Hz, gamma_low 30–45 Hz. Online path model uses four bands through beta. Tool scores are learned outputs rather than physiological biomarker directions; covariance is not directed functional connectivity. No resting baseline is assumed for raw path classification.",
