    {
      "id": "lee2026-eeg",
      "title": "Cybersickness-induced EEG responses in curved monitor and head-mounted display",
      "year": 2026,
      "doi": "10.1038/s41598-025-32858-2",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12860796/",
      "locator": "EEG recording and data process; Results, Evaluate cybersickness within each display, Tables 1–2; Discussion, alpha/theta/beta/gamma and final EEG–SSQ paragraphs",
      "excerpt": "In 31 susceptible young men, alpha decreased during both displays. Theta and beta changes depended on region and display. Frontal gamma used 30–50 Hz. No EEG–SSQ measure was significantly correlated. Sensory-conflict interpretation remains an explanatory hypothesis.",
      "evidence_level": "medium",
      "review_status": "reviewed",
      "source_layer": "paper_evidence",
      "excerpt_type": "paraphrase",
      "verification_date": "2026-10-13",
